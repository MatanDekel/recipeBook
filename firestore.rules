rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function famPath(fid) { return /databases/$(database)/documents/families/$(fid); }
    function fam(fid) { return get(famPath(fid)).data; }
    function isMember(fid) {
      return signedIn() && exists(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid));
    }

    // פרופיל אישי: לאיזה ספר המשתמש שייך
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ספר מתכונים (משפחה)
    match /families/{fid} {
      allow read: if isMember(fid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      // כל חבר יכול לשנות את שם הספר, אבל רק הבעלים יכול לשנות בעלות או קוד הזמנה
      allow update: if isMember(fid) && (
        resource.data.ownerUid == request.auth.uid
        || (request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.inviteCode == resource.data.inviteCode)
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // חברי הספר: הצטרפות רק כבעלים או עם קוד ההזמנה מהקישור
      match /members/{uid} {
        allow read: if isMember(fid);
        allow create: if signedIn() && request.auth.uid == uid && (
          fam(fid).ownerUid == uid
          || (request.resource.data.code is string && request.resource.data.code == fam(fid).inviteCode)
        );
        allow update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || fam(fid).ownerUid == request.auth.uid);
      }

      // המתכונים והמצב המשותף (סימוני "אהבנו", מספר מנות)
      match /recipes/{rid} {
        allow read, write: if isMember(fid);
      }
      match /state/{doc} {
        allow read, write: if isMember(fid);
      }
    }
  }
}
